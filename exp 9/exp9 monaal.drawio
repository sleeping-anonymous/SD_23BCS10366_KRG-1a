        <mxCell id="yZM8KfAOPEB3S9nS4MOV-16" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;li data-section-id=&quot;18ocbgg&quot; data-start=&quot;461&quot; data-end=&quot;501&quot;&gt;Seat availability fetch: &lt;strong data-start=&quot;488&quot; data-end=&quot;501&quot;&gt;50–150 ms&lt;/strong&gt;&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;li data-section-id=&quot;8774ac&quot; data-start=&quot;502&quot; data-end=&quot;541&quot;&gt;&lt;br/&gt;Seat selection (lock): &lt;strong data-start=&quot;527&quot; data-end=&quot;541&quot;&gt;100–300 ms&lt;/strong&gt;&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;li data-section-id=&quot;a3pugc&quot; data-start=&quot;542&quot; data-end=&quot;578&quot;&gt;&lt;br/&gt;Payment initiation: &lt;strong data-start=&quot;564&quot; data-end=&quot;578&quot;&gt;200–500 ms&lt;/strong&gt;&lt;/li&gt;" vertex="1">
