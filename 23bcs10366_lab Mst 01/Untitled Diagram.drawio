    <mxGraphModel dx="1895" dy="1138" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="u0faRNJhSvnPHEbUG3cD-2" parent="1" style="whiteSpace=wrap;html=1;" value="Design instagram (req user login servce,2 content dervice, 3. feed service,4. follower service,5. user engagement serv)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Implement mechanism to restrict user for posting non policy compliant post&lt;/div&gt;&lt;div&gt;OPtimize dynamic feed generation for users&lt;/div&gt;&lt;div&gt;HIghlight the use of backfill serv&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="440" x="205" y="50" as="geometry" />
        </mxCell>
        <mxCell id="u0faRNJhSvnPHEbUG3cD-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1. FR:&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;div&gt;i.user should be able to login and register&lt;/div&gt;&lt;div&gt;ii.user should be able to post&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;iii. user should be able to like,comment and follow&lt;/div&gt;&lt;div&gt;iv. Feed generation(imp)&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="340" x="220" y="180" as="geometry" />
        </mxCell>
        <mxCell id="u0faRNJhSvnPHEbUG3cD-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2. NFR:::(1 million DAU)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;i. availability &amp;gt;&amp;gt;&amp;gt; consistency (eventual consistency)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ii. latency should be low (50ms)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;iii. 50 posts should be visible at once&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="270" x="260" y="400" as="geometry" />
        </mxCell>
        <mxCell id="u0faRNJhSvnPHEbUG3cD-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3. DB SCHEMA DESIGN&lt;div&gt;:::&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;i. users db(user id, name,password(encrypted/hashed))&lt;/div&gt;&lt;div&gt;ii. follower db(user id , followers )&lt;/div&gt;&lt;div&gt;iii. content db(user id, posts,likes, comments)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;iv. engagement db&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="245" y="640" as="geometry" />
        </mxCell>
        <mxCell id="u0faRNJhSvnPHEbUG3cD-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4. API DESIGN :::&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. /login&amp;nbsp; :: login&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. / register&amp;nbsp; :: register user&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. users :: get users&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. /user/{id} :: get particular user&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;5.&amp;nbsp; /user/posts&amp;nbsp; :: get user&#39;s posts&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;6./user/feed&amp;nbsp; :: get users feed&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="230" x="295" y="850" as="geometry" />
